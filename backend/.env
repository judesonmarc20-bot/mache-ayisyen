DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-super-secret-key-before-production"
PORT=4000

# ---- MonCash (peman mobil Digicel) ----
# Jwenn kle sa yo lè ou kreye yon kont "MonCash Business" sou
# https://moncashbutton.digicelgroup.com (gen yon vèsyon "sandbox" gratis
# pou teste anvan ou pase an pwodiksyon). Kite yo vid pou kounye a si ou
# poko gen yo -- peman an ap voye yon erè klè jiskaske ou ranpli yo.
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=

# ---- Stripe (peman kat kredi/debi pou dyaspora) ----
# Jwenn kle a sou https://dashboard.stripe.com/apikeys (gen yon mòd "test"
# gratis -- kle test yo kòmanse ak sk_test_...). Kite l vid si ou pa vle
# ofri peman kat pou kounye a.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
# To chanj pou konvèti Goud -> Dola (paske Stripe pa toujou sipòte HTG).
# Ajiste selon to mache a (egzanp: 1 USD = 132 HTG).
GOURDES_PER_USD=132

# URL frontend la (pou Stripe konnen ki kote pou l retounen kliyan an).
FRONTEND_URL=http://localhost:5173
